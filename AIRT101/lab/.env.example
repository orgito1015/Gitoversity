# Copy to .env before starting the lab: cp .env.example .env
# Flags are base64 encoded (b64: prefix) so they are not stored in plain text.
# Decoding them skips the course. Solve the challenge instead.
FLAG1=b64:R0lUT3tkMXIzY3RfMW5qM2N0MTBuX3NwaTExc190aDNfcHIwbXB0fQ==
FLAG2=b64:R0lUT3sxbmQxcjNjdF8xbmozY3QxMG5fdjFhX3AwMXMwbjNkX2QwY3N9
# Any Ollama model tag. llama3.2:1b needs about 4 GB RAM. Try llama3.2:3b for a stronger target.
MODEL=llama3.2:1b
# 1 = no defenses, 2 = naive keyword filter on chat input
LEVEL=1
