# Copy to .env before starting: cp .env.example .env
# Flags are base64 encoded (b64: prefix) so they are not stored in plain text.
# Decoding them skips the course. Solve the challenge instead.
FLAG1=b64:R0lUT3sxZDByX3IzNGRzX3RoM19uM2lnaGIwcnNfbjB0M30=
FLAG2=b64:R0lUT3tyMGIwdHNfdHh0X2wzZF9tM190MF90aDNfYzBuZjFnfQ==
# 1 = vulnerable (default), 2 = fixes applied (access control, output escaping, headers)
LEVEL=1
